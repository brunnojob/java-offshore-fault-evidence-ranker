{
  "repository": "brunnojob/java-offshore-fault-evidence-ranker",
  "inputs": [
    ".proof/scenarios.json",
    "examples/input.txt"
  ],
  "cases": [
    {
      "name": "javac Main.java && java Main --self-test && java Main < examples/input.txt",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "javac Main.java && java Main --self-test && java Main < examples/input.txt"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "Application demonstration with checked output",
      "argv": [
        "java",
        "Main"
      ],
      "input": "examples/input.txt",
      "contains": [
        "bearing,0.68085106"
      ]
    },
    {
      "name": "Reject an empty capture",
      "argv": [
        "java",
        "Main"
      ],
      "stdin": "",
      "exit": 2
    },
    {
      "name": "Reject malformed input",
      "argv": [
        "java",
        "Main"
      ],
      "stdin": "broken,input\n",
      "exit": 2
    },
    {
      "name": "Reject unsupported invocation",
      "argv": [
        "java",
        "Main",
        "--unsupported"
      ],
      "exit": 2,
      "contains": [
        "arguments"
      ]
    },
    {
      "name": "Reject an oversized input record",
      "argv": [
        "java",
        "Main"
      ],
      "stdin": "\n",
      "exit": 2,
      "contains": [
        "record too large"
      ]
    }
  ]
}
